# ---------------------------------------------------------------------------
# Villiz Social Manager — PRODUCTION environment template (Sprint 8.0)
#
# Variable NAMES and SAFE PLACEHOLDERS ONLY. Never fill in real values here
# and never commit a file with real values under any name resembling this
# one — .env.production and .env.staging are explicitly gitignored for
# exactly that reason (see .gitignore).
#
# Real values are set directly in each hosting platform's own dashboard:
#   - Vercel:  Project Settings -> Environment Variables (Production)
#   - Render:  the background worker service's Environment tab
# Neither platform ever reads a committed .env file for its real values —
# this file exists purely so a human (or `npm run production:check`) has one
# place to see every variable name, what it does, and where it belongs.
#
# See docs/PRODUCTION_DEPLOYMENT.md and docs/RENDER_WORKER.md for the full
# setup walkthrough, and docs/AUTH_PRODUCTION_SETUP.md for the Supabase auth
# side of NEXT_PUBLIC_SITE_URL.
#
# Column key used in comments below:
#   [Vercel]  required by the Next.js web app
#   [Render]  required by the background publishing worker
# ---------------------------------------------------------------------------

# [Vercel] The exact production URL the web app is actually reachable at
# (your Vercel production domain, or your custom domain once attached).
# Magic-link sign-in emails are built as `${NEXT_PUBLIC_SITE_URL}/auth/callback`
# — get this wrong and every sign-in link redirects to the wrong host.
# Never leave unset in production: env.ts falls back to
# "http://localhost:3000" for local dev convenience only, and
# `npm run production:check` fails if that fallback is what's live.
# Do not guess this value ahead of time — Vercel assigns it on first deploy.
# See docs/AUTH_PRODUCTION_SETUP.md.
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# [Vercel] [Render] Supabase project URL (Project Settings -> API). Must be a
# real https:// cloud project — never localhost/127.0.0.1/*.local. This is
# the ONLY Supabase URL variable the application code actually reads (see
# SUPABASE_URL below for why a second URL variable exists in this file but
# isn't consumed by anything).
NEXT_PUBLIC_SUPABASE_URL="https://your-production-project-ref.supabase.co"

# [Vercel] Public anon key (Project Settings -> API). Safe to expose to the
# browser ONLY because Row Level Security is enforced on every table — never
# skip RLS on a new table because "the anon key is public anyway."
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Not read by any code in this repository today — every call site uses
# NEXT_PUBLIC_SUPABASE_URL above instead (grep confirms this; see the
# deployment audit in docs/PRODUCTION_DEPLOYMENT.md). Included here only
# because some tooling/conventions expect a plain SUPABASE_URL to exist
# alongside SUPABASE_SERVICE_ROLE_KEY. Safe to set to the same value as
# NEXT_PUBLIC_SUPABASE_URL above, or leave unset — nothing breaks either way.
SUPABASE_URL="https://your-production-project-ref.supabase.co"

# [Vercel] [Render] Service role key (Project Settings -> API). Server-only —
# NEVER prefix with NEXT_PUBLIC_, never send to the browser, never log it.
# Used for platform administration, the publishing repository, and every
# write the background worker makes. Vercel needs it for server actions;
# Render needs it for the worker. Rotate immediately if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# [Vercel] Comma-separated email domains permitted to sign in. Villiz is an
# internal platform: clients must never be able to authenticate.
ALLOWED_EMAIL_DOMAINS="villiz.com"

# [Vercel] MUST be "false" (or unset) in production. This is a dev-only
# sign-in shortcut; the route it gates (/api/dev/session) already refuses to
# do anything unless NODE_ENV is also "development" — which a real Vercel
# production build never is — so this is defense in depth, not the only
# thing standing between the shortcut and the internet. Never set "true"
# here regardless.
ENABLE_DEV_LOGIN="false"

# [Vercel] A real, currently-active safety bypass for the review workflow's
# self-approval prevention — NOT a placeholder concept. Villiz Social
# Manager's ordinary rule is that nobody can approve their own draft; the
# hosted beta pilot organisation currently has exactly one staff member, so
# without this flag no draft could ever be approved and the Instagram
# publishing smoke test in docs/HOSTED_SMOKE_TEST.md could never run.
# `npm run production:check` WARNS (does not fail) when this is "true",
# specifically so it stays a visible, deliberate decision. Set back to
# "false" the moment a second approver exists in the pilot organisation —
# see core/domain/entities/review.ts's isSoleOwnerPilotOrganisation for the
# other half of this check.
CLOUD_PILOT_SELF_APPROVAL="true"

# [Vercel] Shared bearer token for the read-only n8n/Awo automation gateway.
# Generate once with `openssl rand -hex 32` and store the same value in n8n.
# Never expose it through NEXT_PUBLIC_, commit it, or place it in Render.
GENESIS_AUTOMATION_API_KEY="replace-with-a-random-64-character-hex-token"

# ---------------------------------------------------------------------------
# Blotato — real social publishing
# One shared connection for the whole platform, not per client organisation.
# See docs/PUBLISHING_ENGINE.md's "Blotato integration" section.
# ---------------------------------------------------------------------------

# [Vercel] [Render] From https://my.blotato.com (Settings -> API -> Generate
# API Key). Vercel needs this for the Publishing Settings "Test Connection"
# button (a read-only call); Render needs it for the worker to actually
# submit posts.
BLOTATO_API_KEY="your-blotato-api-key"

# [Vercel] [Render] Master switch for the integration. "false"/unset: Test
# Connection and the worker both treat Blotato as "not configured" without
# attempting a network call.
BLOTATO_ENABLED="true"

# [Render] The safety switch for *live publishing*, independent of
# BLOTATO_ENABLED above. Only ever read by the background worker
# (BlotatoPublisherBase, resolved exclusively inside scripts/publishing-worker-
# core.ts) — the web app never reads this value, so it has no effect if set
# on Vercel. While "false", every publish is simulated exactly as before
# Sprint 6B, regardless of anything else in this file. Flip to "true" only
# when you are ready for the worker to call Blotato's real POST /posts —
# see docs/HOSTED_SMOKE_TEST.md before doing so on the pilot organisation.
BLOTATO_LIVE_PUBLISHING_ENABLED="false"
