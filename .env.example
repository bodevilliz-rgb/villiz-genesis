# ---------------------------------------------------------------------------
# Project Genesis — environment
# Copy to .env.local for development. Set the same keys in Vercel.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Public anon key. Safe in the browser ONLY because RLS is enforced on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key. Server-only. Never expose with a NEXT_PUBLIC_ prefix.
# Used exclusively for platform administration (inviting Villiz staff).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Canonical site URL. Required so magic links return to the right origin.
# Local development runs on 3001 (see npm run dev:local) — 3000 is left free
# for anything else already running on this machine.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Comma-separated email domains permitted to sign in.
# Villiz is an internal platform: clients must never be able to authenticate.
ALLOWED_EMAIL_DOMAINS="villiz.com"
GENESIS_AUTOMATION_API_KEY="replace-with-a-random-64-character-hex-token"

# Development-only sign-in shortcut. Leave unset everywhere except your own
# .env.local. Has no effect unless NODE_ENV is also "development" — it cannot
# do anything in a production build regardless of this value.
# ENABLE_DEV_LOGIN="true"

# ---------------------------------------------------------------------------
# Blotato — real social publishing (Sprint 6B)
# One shared connection for the whole platform, not per client organisation.
# See docs/PUBLISHING_ENGINE.md's "Blotato integration" section.
# ---------------------------------------------------------------------------

# From https://my.blotato.com (Settings -> API -> Generate API Key). Required
# to reach Blotato at all; leaving it unset just makes Test Connection report
# "not configured" instead of breaking the build.
BLOTATO_API_KEY="your-blotato-api-key"

# Master switch for the integration. false/unset: Test Connection and the
# Publishing Settings page report "not configured" without attempting a
# network call. Reading connected accounts still requires a valid
# BLOTATO_API_KEY above.
BLOTATO_ENABLED="true"

# Safety switch for *publishing*, independent of BLOTATO_ENABLED above.
# While false (the required default — do not flip in shared environments
# without an explicit decision to go live), BlotatoPublisherBase never calls
# Blotato's real POST /posts endpoint; every publish is simulated exactly as
# the old Mock*Publisher adapters were, regardless of anything else in this
# file. Test Connection and account listing are read-only and unaffected by
# this flag either way.
BLOTATO_LIVE_PUBLISHING_ENABLED="false"
