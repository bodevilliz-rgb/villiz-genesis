# ---------------------------------------------------------------------------
# Project Genesis — environment
# Copy to .env.local for development. Set the same keys in Vercel.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Public anon key. Safe in the browser ONLY because RLS is enforced on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service role key. Server-only. Never expose with a NEXT_PUBLIC_ prefix.
# Used exclusively for platform administration (inviting Villiz staff).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Canonical site URL. Required so magic links return to the right origin.
# Local development runs on 3001 (see npm run dev:local) — 3000 is left free
# for anything else already running on this machine.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Comma-separated email domains permitted to sign in.
# Villiz is an internal platform: clients must never be able to authenticate.
ALLOWED_EMAIL_DOMAINS="villiz.com"

# Development-only sign-in shortcut. Leave unset everywhere except your own
# .env.local. Has no effect unless NODE_ENV is also "development" — it cannot
# do anything in a production build regardless of this value.
# ENABLE_DEV_LOGIN="true"
